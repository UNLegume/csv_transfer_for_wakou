# Shopifyカスタムアプリ（読取専用）
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret
SHOPIFY_API_VERSION=2026-07

# 操作画面のBasic認証（本番では十分に長いランダムな値へ変更）
WAKOU_AUTH_USERNAME=operator
WAKOU_AUTH_PASSWORD=change-this-to-a-long-random-password

# 発送元・依頼主
WAKOU_SENDER__COMPANY_NAME=株式会社サンプル
WAKOU_SENDER__REQUESTER_NAME=通販部
WAKOU_SENDER__POSTAL_CODE=1000001
WAKOU_SENDER__ADDRESS=東京都千代田区千代田1-1
WAKOU_SENDER__PHONE=0312345678

# 佐川（サンプル値。実運用前に株式会社ワコウへ確認してください）
WAKOU_SAGAWA__BILLING_CODE=000123456789
WAKOU_SAGAWA__AMOUNT=0
WAKOU_SAGAWA__AMOUNT_UNIT=0円
WAKOU_SAGAWA__INCLUDE_DELIVERY_DATE=true
WAKOU_SAGAWA__SERVICE_TYPE=1
WAKOU_SAGAWA__OPTION1=必着
WAKOU_SAGAWA__OPTION2=ご不在の際は不在票を入れて下さい
WAKOU_SAGAWA__OPTION3=送り主：
WAKOU_SAGAWA__OPTION4=配達指定
WAKOU_SAGAWA__OPTION5=【
WAKOU_SAGAWA__OPTION6=】
WAKOU_SAGAWA__POSTAL_TYPE=0
WAKOU_SAGAWA__PAYMENT_TYPE=1
WAKOU_SAGAWA__COD_TYPE=Yes

# ヤマト／ネコポス（サンプル値。実運用前に株式会社ワコウへ確認してください）
WAKOU_YAMATO__REQUESTER_CODE=000987654321
WAKOU_YAMATO__LABEL_TYPE=A
WAKOU_YAMATO__ITEM_NAME=ネットショップ購入品
WAKOU_YAMATO__COLLECT_AMOUNT=0
WAKOU_YAMATO__COLLECT_TAX=0
WAKOU_YAMATO__BILLING_CLASSIFICATION_CODE=
WAKOU_YAMATO__FREIGHT_MANAGEMENT_NUMBER=

# 配送判定
WAKOU_YAMATO_QUANTITY_LIMIT=1
